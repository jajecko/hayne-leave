CI_ENV=production

JORANI_VERSION=v1.0.4
APP_PORT=8080

MYSQL_HOST=mysql
MYSQL_USER=jorani
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=jorani
MYSQL_ROOT_PASSWORD=change-me-root

BASE_URL=http://localhost:8080/
ENC_KEY=change-this-to-a-long-random-application-key

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_CRYPTO=tls

FROM_MAIL=no-reply@hayne.pl
FROM_NAME=HAYNE Leave
SUBJECT_PREFIX=[HAYNE Leave]

LANGUAGE=english
LANGUAGES=en
DEFAULT_TIMEZONE=Europe/Warsaw

LOG_THRESHOLD=2
LOG_PATH=php://stdout
DEBUGBAR_ENABLED=FALSE
DEBUGBAR_RENDER_IN_FOOTER=FALSE

# Keep Jorani's native LDAP login disabled until HTTPS/auth work is explicitly delivered.
LDAP_ENABLED=FALSE
SAML_ENABLED=FALSE
API_ENABLED=TRUE

# HAYNE AD directory preview/planner. The bind password belongs only in deployment .env.
HAYNE_AD_SYNC_ENABLED=FALSE
HAYNE_AD_HOSTS=hayne-srv-ad01.hayne.pl,hayne-srv-ad02.hayne.pl
HAYNE_AD_PORT=636
HAYNE_AD_BASE_DN=OU=O365 Users,OU=HayneUsers,DC=hayne,DC=pl
HAYNE_AD_BIND_DN=HAYNE\svc_jorani_ldap
HAYNE_AD_BIND_PASSWORD=
HAYNE_AD_CA_FILE=/opt/hayne/certs/hayne-ad-ca-chain.pem
HAYNE_AD_EMPLOYEE_TYPE=Employee
HAYNE_AD_NETWORK_TIMEOUT=5
HAYNE_AD_TIME_LIMIT=10

# Write gate for PR-AD-03. Dry-run stays read-only even when sync is enabled.
HAYNE_AD_APPLY_ENABLED=FALSE
HAYNE_AD_DEFAULT_ROLE_ID=2
HAYNE_AD_DEFAULT_CONTRACT_ID=1
HAYNE_AD_DEFAULT_LANGUAGE=en
HAYNE_AD_DEFAULT_TIMEZONE=Europe/Warsaw
HAYNE_AD_MAX_USER_CHANGES=50
HAYNE_AD_PROTECTED_LOGINS=jadmin

# On QNAP set this to /share/Container/jorani/certs. Never commit the private deployment path or bind secret.
LDAP_CA_HOST_DIR=./certs

DEFAULT_LEAVE_TYPE=1
DISABLE_OVERTIME=TRUE
OVERTIME_COMPENSATION_TYPE=0
HIDE_GLOBAL_CALS_TO_USERS=FALSE
DISABLE_DEPARTMENT_CALENDAR=FALSE
DISABLE_WORKMATES_CALENDAR=FALSE
REQUESTS_BY_MANAGER=TRUE
DISALLOW_REQUESTS_WITHOUT_CREDIT=TRUE
ENABLE_HISTORY=TRUE
