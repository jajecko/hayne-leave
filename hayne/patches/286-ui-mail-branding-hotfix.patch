+#wrap .alert-block {
+  border-color: #dfc980;
+}
+
+#wrap .alert-success {
+  border-color: #bfd7c7;
+}
+
+#wrap .alert-info {
+  border-color: #c8d7e1;
+}
+
+#wrap .alert-error,
+#wrap .alert-danger {
+  border-color: #e0bcbc;
+}
+
+#wrap .alert .close {
+  position: absolute;
+  top: 50%;
+  right: 12px;
+  float: none;
+  margin: 0;
+  transform: translateY(-50%);
+  color: #555;
+  opacity: .65;
+  text-shadow: none;
+  line-height: 1;
+}
+
+#wrap .alert .close:hover,
+#wrap .alert .close:focus {
+  color: #111;
+  opacity: 1;
