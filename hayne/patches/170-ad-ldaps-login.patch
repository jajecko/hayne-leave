+    /**
+     * Authenticate one active, synchronized HAYNE employee against AD over
+     * LDAPS. The exact DN comes from hayne_ad_identity; no directory search or
+     * service-account bind is needed during interactive login.
+     */
+    private function authenticateHayneAd(string $login, string $distinguishedName, string $password): bool
+    {
+        if ($password === '' || $distinguishedName === '') {
+            return FALSE;
+        }
+
+        $caFile = (string) $this->config->item('hayne_ad_auth_ca_file');
+        if ($caFile === '' || !is_readable($caFile)) {
+            log_message('error', '{controllers/session/login} HAYNE AD CA file is missing or unreadable');
+            return FALSE;
+        }
+
+        if (!defined('LDAP_OPT_X_TLS_CACERTFILE') ||
+            !defined('LDAP_OPT_X_TLS_REQUIRE_CERT') ||
+            !defined('LDAP_OPT_X_TLS_DEMAND')) {
+            log_message('error', '{controllers/session/login} HAYNE AD TLS options are unavailable');
+            return FALSE;
+        }
+
+        // TLS options must be configured before ldap_connect() creates the
+        // connection object used by the LDAPS bind.
+        if (!ldap_set_option(NULL, LDAP_OPT_X_TLS_CACERTFILE, $caFile) ||
+            !ldap_set_option(NULL, LDAP_OPT_X_TLS_REQUIRE_CERT, LDAP_OPT_X_TLS_DEMAND)) {
+            log_message('error', '{controllers/session/login} HAYNE AD TLS configuration failed');
+            return FALSE;
+        }
+
+        $hosts = array_values(array_filter(array_map('trim', explode(',', (string) $this->config->item('hayne_ad_auth_hosts')))));
+        if (count($hosts) === 0) {
+            log_message('error', '{controllers/session/login} HAYNE AD has no configured hosts');
+            return FALSE;
+        }
+
+        $port = (int) $this->config->item('hayne_ad_auth_port');
+        $networkTimeout = max(1, (int) $this->config->item('hayne_ad_auth_network_timeout'));
+        $timeLimit = max(1, (int) $this->config->item('hayne_ad_auth_time_limit'));
+
+        foreach ($hosts as $host) {
+            $ldapUri = sprintf('ldaps://%s:%d', $host, $port);
+            $ldap = ldap_connect($ldapUri);
+            if ($ldap === FALSE) {
+                continue;
+            }
+
+            ldap_set_option($ldap, LDAP_OPT_PROTOCOL_VERSION, 3);
+            ldap_set_option($ldap, LDAP_OPT_REFERRALS, 0);
+            ldap_set_option($ldap, LDAP_OPT_NETWORK_TIMEOUT, $networkTimeout);
+            ldap_set_option($ldap, LDAP_OPT_TIMELIMIT, $timeLimit);
+
+            // ldap_bind() warnings deliberately do not expose bind details to
+            // the UI. A failure simply tries the second configured DC.
+            $bind = @ldap_bind($ldap, $distinguishedName, $password);
+            ldap_unbind($ldap);
+
+            if ($bind === TRUE) {
+                return $this->users_model->checkCredentialsLDAP($login);
+            }
+        }
+
+        log_message('error', '{controllers/session/login} HAYNE AD authentication failed for user=' . $login);
+        return FALSE;
+    }
+
+    /**
+     * Check the comma-separated local break-glass allow-list.
+     */
+    private function isHayneLocalLoginAllowed(string $login): bool
+    {
+        $allowed = array_values(array_filter(array_map('trim', explode(',', (string) $this->config->item('hayne_ad_auth_local_logins')))));
+        foreach ($allowed as $allowedLogin) {
+            if (strcasecmp($login, $allowedLogin) === 0) {
+                return TRUE;
+            }
+        }
+        return FALSE;
+    }
