+    /**
+     * Return the AD distinguished name for an active HAYNE-managed user.
+     * Presence in hayne_ad_identity is the authority boundary between AD
+     * accounts and local break-glass accounts.
+     * @param string $login user login
+     * @return string distinguished name or an empty string when not AD-managed
+     */
+    public function getHayneAdDistinguishedName(string $login): string
+    {
+        if (!$this->db->table_exists('hayne_ad_identity')) {
+            return '';
+        }
+
+        $this->db->select('hayne_ad_identity.distinguished_name');
+        $this->db->from('users');
+        $this->db->join('hayne_ad_identity', 'hayne_ad_identity.user_id = users.id');
+        $this->db->where('users.login', $login);
+        $this->db->where('users.active = TRUE');
+        $query = $this->db->get();
+
+        if ($query->num_rows() !== 1) {
+            return '';
+        }
+
+        return (string) ($query->row()->distinguished_name ?? '');
+    }
