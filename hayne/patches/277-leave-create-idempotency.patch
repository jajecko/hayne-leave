+                button.setAttribute('aria-disabled', 'true');
+                button.style.pointerEvents = 'none';
+            });
+
+            window.setTimeout(function () {
+                if (!event.defaultPrevented) return;
+                form.dataset.hayneSubmissionLocked = '0';
