 <script src="<?php echo base_url(); ?>assets/js/bootbox.min.js"></script>
+<script>
+    (function () {
+        var form = document.getElementById('frmLeaveForm');
+        if (!form) return;
+
+        form.addEventListener('submit', function (event) {
+            if (form.dataset.hayneSubmissionLocked === '1') {
+                event.preventDefault();
+                return;
+            }
+
+            form.dataset.hayneSubmissionLocked = '1';
+            var submitters = form.querySelectorAll('button[type="submit"]');
+            Array.prototype.forEach.call(submitters, function (button) {
+                button.setAttribute('aria-disabled', 'true');
+                button.style.pointerEvents = 'none';
+            });
+
+            window.setTimeout(function () {
+                if (!event.defaultPrevented) return;
+                form.dataset.hayneSubmissionLocked = '0';
+                Array.prototype.forEach.call(submitters, function (button) {
+                    button.removeAttribute('aria-disabled');
+                    button.style.pointerEvents = '';
+                });
+            }, 0);
+        });
+    })();
+</script>
